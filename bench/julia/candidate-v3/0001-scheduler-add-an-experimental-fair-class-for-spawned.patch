+# The R heaps: a second set of stock heaps, for request work in flight (see below), through stock's
+# four bodies above. Empty and unsized until a task of class R is inserted.
+const r_heaps = [Vector{taskheap}(undef, 0), Vector{taskheap}(undef, 0)]
+const r_heaps_lock = [SpinLock(), SpinLock()]

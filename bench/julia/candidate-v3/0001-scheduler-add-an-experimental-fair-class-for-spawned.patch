     end
 end
+
+# `Threads.@spawn fair=true` (experimental): the keyword, the class each task gets at its first
+# enqueue, and that marked work is neither lost nor run twice, cancelled or not. A pool of one
+# thread never reaches the multiqueue, so there a mark is kept as set and nothing else is classed.
+@testset "@spawn fair=" begin
+    P = Base.Partr
+    cls(t::Task = current_task()) = @atomic :monotonic t.sched_class
+    nd = threadpoolsize(:default)
+    multi = nd >= 2
+    # every thread in `tids` held by a spinner pinned to it; `release` ends them
+    function hold(tids)
+        go = Threads.Atomic{Bool}(true)
+        up = Threads.Atomic{Int}(0)
+        ts = [spawn_pinned(tid) do
+                  Threads.atomic_add!(up, 1)
+                  while go[]
+                      GC.safepoint()
+                      ccall(:jl_cpu_pause, Cvoid, ())
+                  end
+              end for tid in tids]
+        while up[] < length(tids)
+            yield()
+        end
+        return go, ts
+    end
+    release(go, ts) = (go[] = false; foreach(wait, ts))
+    parked(t::Task) = istaskstarted(t) && (@atomic :monotonic t.waiting_on) !== nothing
+    cancellable(f) = (src = Base.CancellationTokenSource();
+                      (Base.ScopedValues.with(f, Base.CANCEL_TOKEN => Base.CancellationToken(src)), src))
+    # the :default threads other than this task's own
+    free = [tid for tid in Threads.threadpooltids(:default) if tid != Threads.threadid()]
+
+    @testset "keyword" begin
+        x = 40
+        @test fetch(Threads.@spawn fair=(x > 0) $x + 2) == 42
+        @test fetch(Threads.@spawn :default fair=true cls()) == P.C_F
+        @test fetch(Threads.@spawn fair=false cls()) == P.C_NONE
+        @test fetch(Threads.@spawn :default fair=false cls()) == P.C_NONE
+        @test_throws ArgumentError @macroexpand Threads.@spawn unfair=true 1
+        t = Threads.@spawn nothing
+        wait(t)
+        @test_throws ArgumentError Threads._spawn_set_fair(t, true)
+        @test cls(Base.roottask) == P.C_NONE
+    end
+
+    @testset "classes" begin
+        function classes()
+            r = Dict{Symbol,Any}()
+            r[:self] = cls()
+            r[:spawn] = fetch(Threads.@spawn cls())
+            local t
+            @sync t = Threads.@spawn cls()
+            r[:sync] = fetch(t)
+            ws = fill(0xff, 2nd)
+            Threads.@threads :dynamic for i in 1:2nd
+                ws[i] = cls()
+            end
+            r[:threads] = unique(ws)
+            yield()
+            r[:after] = cls()
+            return r
+        end
+        m = fetch(Threads.@spawn fair=true classes())
+        kid = multi ? P.C_R : P.C_NONE
+        @test m[:self] == P.C_F                      # a marked root before it has waited
+        @test m[:after] == (multi ? P.C_R : P.C_F)   # once it has started and waited
+        @test m[:spawn] == m[:sync] == kid
+        @test m[:threads] == [kid]
+        u = fetch(Threads.@spawn classes())
+        @test u[:self] == u[:spawn] == u[:sync] == u[:after] == P.C_NONE
+        @test u[:threads] == [P.C_NONE]
+        # a marked task of another pool keeps its mark only where it never reaches the multiqueue
+        tp, c = fetch(Threads.@spawn :interactive fair=true (Threads.threadpool(), cls()))
+        @test c == (tp === :default || threadpoolsize(tp) == 1 ? P.C_F : P.C_NONE)
+    end
+
+    @testset "every marked task runs once" begin
+        nr, nk = 8nd, 4
+        hits = [Threads.Atomic{Int}(0) for _ in 1:nr*(nk + 1)]
+        @sync for i in 1:nr
+            Threads.@spawn fair=true begin
+                Threads.atomic_add!(hits[(i - 1)*(nk + 1) + 1], 1)
+                @sync for j in 1:nk
+                    Threads.@spawn Threads.atomic_add!(hits[(i - 1)*(nk + 1) + 1 + j], 1)
+                end
+            end
+        end
+        @test all(h -> h[] == 1, hits)
+    end
+
+    @testset "cancelled marked work runs at most once" begin
+        # a marked root cancelled while still queued: every other :default thread is held, and
+        # this task does not yield until the root is cancelled
+        go, ts = hold(free)
+        ran = Threads.Atomic{Int}(0)
+        t, src = cancellable() do
+            Threads.@spawn fair=true (Threads.atomic_add!(ran, 1); Base.@cancel_check; :not_cancelled)
+        end
+        @test ran[] == 0
+        Base.cancel!(src)
+        release(go, ts)
+        @test_throws TaskFailedException wait(t)
+        @test ran[] <= 1 && t.result isa Base.CancellationRequest
+
+        # request work in flight: a marked root and its child, both parked
+        kid = Ref{Task}()
+        ran = Threads.Atomic{Int}(0)
+        t, src = cancellable() do
+            Threads.@spawn fair=true begin
+                kid[] = Threads.@spawn (Threads.atomic_add!(ran, 1); sleep(1000))
+                sleep(1000)
+            end
+        end
+        while !(parked(t) && isassigned(kid) && parked(kid[]))
+            sleep(0.001)
+        end
+        Base.cancel!(src)
+        @test_throws TaskFailedException wait(t)
+        @test_throws TaskFailedException wait(kid[])
+        @test ran[] == 1 && kid[].result isa Base.CancellationRequest
+
+        # the marked children of a @sync, parked
+        nk = 2nd
+        hits = [Threads.Atomic{Int}(0) for _ in 1:nk]
+        t, src = cancellable() do
+            Threads.@spawn fair=true @sync for i in 1:nk
+                Threads.@spawn fair=true (Threads.atomic_add!(hits[i], 1); sleep(1000))
+            end
+        end
+        while !(all(h -> h[] == 1, hits) && parked(t))
+            sleep(0.001)
+        end
+        Base.cancel!(src)
+        @test_throws TaskFailedException wait(t)
+        @test all(h -> h[] == 1, hits)
+
+        # the marked children of a @sync, still queued: the root runs on one free thread, the
+        # others are held, and this task does not yield until they are cancelled
+        if !isempty(free)
+            go, ts = hold(free[2:end])
+            hits = [Threads.Atomic{Int}(0) for _ in 1:nk]
+            spawned = Threads.Atomic{Int}(0)
+            spin = Threads.Atomic{Bool}(true)
+            kids = Vector{Task}(undef, nk)
+            t, src = cancellable() do
+                Threads.@spawn fair=true @sync begin
+                    for i in 1:nk
+                        kids[i] = Threads.@spawn fair=true (Threads.atomic_add!(hits[i], 1); sleep(1000))
+                        Threads.atomic_add!(spawned, 1)
+                    end
+                    while spin[]
+                        GC.safepoint()
+                    end
+                end
+            end
+            while spawned[] < nk
+                GC.safepoint()
+            end
+            @test all(h -> h[] == 0, hits)
+            Base.cancel!(src)
+            spin[] = false
+            release(go, ts)
+            @test_throws TaskFailedException wait(t)
+            @test all(h -> h[] <= 1, hits)
+            @test all(istaskfailed, kids)
+        end
+    end
+end

+
+    @testset "every marked task runs once" begin
+        nr, nk = 8nd, 4
+        hits = [Threads.Atomic{Int}(0) for _ in 1:nr*(nk + 1)]
+        @sync for i in 1:nr
+            Threads.@spawn fair=true begin
+                Threads.atomic_add!(hits[(i - 1)*(nk + 1) + 1], 1)
+                @sync for j in 1:nk

+        res = readchomp(`$(Base.julia_cmd()) --startup-file=no --threads=$layout -e $code`)
+        @test res == string(Int(optout), " false")
+    end
+
+    @testset "the weight" begin
+        w0 = @atomic P.fp.w
+        @test w0 == 500
+        @test_throws ArgumentError P.set_fair_weight!(0)
+        @test_throws ArgumentError P.set_fair_weight!(1)
+        @test_throws ArgumentError P.set_fair_weight!(NaN)
+        @test_throws ArgumentError P.set_fair_weight!(-0.5)
+        @test_throws ArgumentError P.set_fair_weight!(0.0004)   # rounds to 0 thousandths
+        @test_throws MethodError P.set_fair_weight!("1/2")
+        @test_throws MethodError P.set_fair_weight!(0.5 + 0im)
+        @test (@atomic P.fp.w) == w0

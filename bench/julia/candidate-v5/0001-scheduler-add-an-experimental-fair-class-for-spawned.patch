+        @test kc == P.C_NONE
+        # in a process where nothing was ever marked: no class, and the flag is not set
+        code = """
+            t = Threads.@spawn fair=false (@atomic :monotonic current_task().sched_class)
+            c = fetch(t)
+            print(Int(c), " ", @atomic(Base.Partr.fl.on))
+            """

     end
 end
+
+# `Threads.@spawn fair=true|false` (experimental): the keyword, the class each task gets at its
+# first enqueue, the opt-out, the weight, and that marked work is neither lost nor run twice,
+# cancelled or not. A pool of one thread never reaches the multiqueue, so there a mark or an
+# opt-out is kept as set and nothing else is classed.
+@testset "@spawn fair=" begin
+    P = Base.Partr
+    cls(t::Task = current_task()) = @atomic :monotonic t.sched_class
+    nd = threadpoolsize(:default)
+    multi = nd >= 2
+    # every thread in `tids` held by a spinner pinned to it; `release` ends them
+    function hold(tids)
+        go = Threads.Atomic{Bool}(true)
+        up = Threads.Atomic{Int}(0)
+        ts = [spawn_pinned(tid) do
+                  Threads.atomic_add!(up, 1)
+                  while go[]
+                      GC.safepoint()
+                      ccall(:jl_cpu_pause, Cvoid, ())
+                  end
+              end for tid in tids]
+        while up[] < length(tids)
+            yield()
+        end
+        return go, ts
+    end
+    release(go, ts) = (go[] = false; foreach(wait, ts))
+    parked(t::Task) = istaskstarted(t) && (@atomic :monotonic t.waiting_on) !== nothing
+    cancellable(f) = (src = Base.CancellationTokenSource();
+                      (Base.ScopedValues.with(f, Base.CANCEL_TOKEN => Base.CancellationToken(src)), src))
+    # the :default threads other than this task's own
+    free = [tid for tid in Threads.threadpooltids(:default) if tid != Threads.threadid()]
+
+    # an opted-out task, once running: its first enqueue cleared the class, except where it never
+    # reached the multiqueue (a pool of one thread)
+    optout = multi ? P.C_NONE : P.C_STOCK
+    kid = multi ? P.C_R : P.C_NONE
+    function spawn_error(ex)
+        try
+            macroexpand(@__MODULE__, ex)
+        catch e
+            return e
+        end
+        return nothing
+    end
+
+    @testset "keyword" begin
+        x = 40
+        @test fetch(Threads.@spawn fair=(x > 0) $x + 2) == 42
+        @test fetch(Threads.@spawn :default fair=true cls()) == P.C_F
+        @test fetch(Threads.@spawn fair=true :default cls()) == P.C_F
+        @test fetch(Threads.@spawn fair=false cls()) == optout
+        @test fetch(Threads.@spawn :default fair=false cls()) == optout
+        @test fetch(Threads.@spawn fair=false :default cls()) == optout
+        y = false
+        @test fetch(Threads.@spawn fair=y :default cls()) == optout
+        @test_throws ArgumentError @macroexpand Threads.@spawn unfair=true 1
+        @test_throws ArgumentError @macroexpand Threads.@spawn :default unfair=true 1
+        # `fair=` anywhere but right before or right after the pool
+        for ex in (:(Threads.@spawn fair=true fair=false 1),
+                   :(Threads.@spawn :default fair=true :default 1),
+                   :(Threads.@spawn fair=true :default :default 1),
+                   :(Threads.@spawn :default :default fair=true 1))
+            e = spawn_error(ex)
+            @test e isa ArgumentError && occursin("right before or right after the threadpool", e.msg)
+        end
+        # the last argument is the expression, whatever its form
+        @test fetch(Threads.@spawn :default fair=true z = 3) == 3
+        t = Threads.@spawn nothing
+        wait(t)
+        @test_throws ArgumentError Threads._spawn_set_fair(t, true)
+        @test_throws ArgumentError Threads._spawn_set_fair(t, false)
+        @test cls(Base.roottask) == P.C_NONE
+    end
+
+    @testset "classes" begin
+        function classes()
+            r = Dict{Symbol,Any}()
+            r[:self] = cls()
+            r[:spawn] = fetch(Threads.@spawn cls())
+            local t
+            @sync t = Threads.@spawn cls()
+            r[:sync] = fetch(t)
+            ws = fill(0xff, 2nd)
+            Threads.@threads :dynamic for i in 1:2nd
+                ws[i] = cls()
+            end
+            r[:threads] = unique(ws)
+            yield()
+            r[:after] = cls()
+            return r
+        end
+        m = fetch(Threads.@spawn fair=true classes())
+        @test m[:self] == P.C_F                      # a marked root before it has waited
+        @test m[:after] == (multi ? P.C_R : P.C_F)   # once it has started and waited
+        @test m[:spawn] == m[:sync] == kid
+        @test m[:threads] == [kid]
+        u = fetch(Threads.@spawn classes())
+        @test u[:self] == u[:spawn] == u[:sync] == u[:after] == P.C_NONE
+        @test u[:threads] == [P.C_NONE]
+    end
+
+    @testset "a mark outside :default" begin
+        # one rule at every layout: the keyword writes a class only on a task whose pool is
+        # `:default` when it is spawned (`:interactive` falls back to `:default` when it has no
+        # thread), so a marked `:interactive` task and its `:default` child have no class
+        for fair in (true, false)

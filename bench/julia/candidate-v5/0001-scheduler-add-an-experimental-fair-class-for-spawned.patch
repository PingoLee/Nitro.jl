+        @test r[1] == optout
+        @test r[2] == P.C_NONE
+        @test r[3] == kid
+        # kept alive past its marked root, it spawns again: still no class
+        go = Channel{Nothing}(1)
+        out = Channel{Tuple{UInt8,UInt8}}(1)
+        root = Threads.@spawn fair=true begin
+            Threads.@spawn fair=false begin
+                take!(go)
+                put!(out, (cls(), fetch(Threads.@spawn cls())))
+            end
